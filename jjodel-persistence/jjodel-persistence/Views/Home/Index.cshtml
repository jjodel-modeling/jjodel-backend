@using System.Globalization
@model jjodel_persistence.Models.Dto.DashboardResponse
@{
    ViewBag.Title = "Dashboard";

    var users = Model.Users;
    var projects = Model.Projects;

    var timeZone = TimeZoneInfo.FindSystemTimeZoneById("Central Europe Standard Time");
}

<!--begin::Row-->
<div class="row">
    <div class="col-lg-2 col-6">
        <div class="small-box text-bg-primary h-75">
            <div class="inner">
                <h3>@users.Total.ToString("N0", CultureInfo.InvariantCulture)</h3>
                <p><i class="bi bi-people"></i> Total Users</p>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-6">
        <div class="small-box text-bg-success h-75">
            <div class="inner">
                <h3>@users.NewLast30Days.ToString("N0", CultureInfo.InvariantCulture)</h3>
                <p><i class="bi bi-person-plus"></i> New Users (30 days)</p>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-6">
        <div class="small-box text-bg-warning h-75">
            <div class="inner">
                <h3>@users.NewLast7Days.ToString("N0", CultureInfo.InvariantCulture)</h3>
                <p><i class="bi bi-calendar-plus"></i> New Users (7 days)</p>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-6">
        <div class="small-box text-bg-info h-75">
            <div class="inner">
                <h3>@users.ActiveLast30Days.ToString("N0", CultureInfo.InvariantCulture)</h3>
                <p><i class="bi bi-person-check"></i> Active Users (30 days)</p>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-6">
        <div class="small-box text-bg-primary h-75">
            <div class="inner">
                <h3>@projects.Total.ToString("N0", CultureInfo.InvariantCulture)</h3>
                <p><i class="bi bi-folder"></i> Total Projects</p>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-6">
        <div class="small-box text-bg-warning h-75">
            <div class="inner">
                <h3>@projects.NewLast30Days.ToString("N0", CultureInfo.InvariantCulture)</h3>
                <p><i class="bi bi-folder-plus"></i> New Projects (30 days)</p>
            </div>
        </div>
    </div>
</div>
<!--end::Row-->

<!--begin::Row-->
<div class="row">
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">New Users per Month</h5>
            </div>
            <div class="card-body">
                <div id="user-growth-chart"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">New Projects per Month</h5>
            </div>
            <div class="card-body">
                <div id="project-growth-chart"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">Users by Last Access</h5>
            </div>
            <div class="card-body">
                <div id="last-access-chart"></div>
            </div>
        </div>
    </div>
</div>
<!--end::Row-->

<!--begin::Row-->
<div class="row">
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">Affiliation</h5>
            </div>
            <div class="card-body">
                <div id="affiliation-chart"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">Country</h5>
            </div>
            <div class="card-body">
                <div id="country-chart"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">Projects by Type</h5>
            </div>
            <div class="card-body d-flex align-items-center">
                <div id="project-type-chart" class="w-100"></div>
            </div>
        </div>
    </div>
</div>
<!--end::Row-->

<!--begin::Row-->
<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">Latest Projects</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Author</th>
                                <th>Type</th>
                                <th>Last Modified</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (projects.Latest.Count == 0) {
                                <tr>
                                    <td colspan="4" class="text-secondary">No projects yet.</td>
                                </tr>
                            }
                            @foreach (var p in projects.Latest) {
                                bool isPublic = string.Equals(p.Type, "public", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td>@p.Name</td>
                                    <td>@(p.Author ?? "-")</td>
                                    <td><span class="badge @(isPublic ? "text-bg-success" : "text-bg-secondary")">@(isPublic ? "Public" : "Private")</span></td>
                                    <td>@TimeZoneInfo.ConvertTimeFromUtc(p.LastModified, timeZone).ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer clearfix">
                <a href="/project" class="btn btn-sm btn-secondary float-end">View All Projects</a>
            </div>
        </div>
    </div>
</div>
<!--end::Row-->

@section Scripts {
    <script>
        (function () {
            // affiliation and country come from user input: strip angle brackets before passing them to ApexCharts.
            const clean = s => String(s).replace(/[<>]/g, '');

            const months = @Json.Serialize(Model.MonthLabels);

            const bar = (color, height) => ({
                chart: { type: 'bar', height: height, toolbar: { show: true } },
                colors: [color],
                plotOptions: { bar: { borderRadius: 4, columnWidth: '60%' } },
                dataLabels: { enabled: false },
                yaxis: { labels: { formatter: v => Math.round(v) } }
            });

            new ApexCharts(document.querySelector('#user-growth-chart'), {
                ...bar('#0d6efd', 250),
                series: [{ name: 'New users', data: @Json.Serialize(Model.Users.NewPerMonth) }],
                xaxis: { categories: months }
            }).render();

            new ApexCharts(document.querySelector('#project-growth-chart'), {
                ...bar('#20c997', 250),
                series: [{ name: 'New projects', data: @Json.Serialize(Model.Projects.NewPerMonth) }],
                xaxis: { categories: months }
            }).render();

            new ApexCharts(document.querySelector('#last-access-chart'), {
                ...bar('#0d6efd', 250),
                series: [{ name: 'Users', data: @Json.Serialize(Model.Users.LastAccessBuckets) }],
                xaxis: { categories: ['< 7d', '7-30d', '30-90d', '90d-1y', '> 1y', 'Never'] }
            }).render();

            const horizontal = (selector, labels, values) => new ApexCharts(document.querySelector(selector), {
                ...bar('#0d6efd', 260),
                plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: '60%' } },
                dataLabels: { enabled: true },
                series: [{ name: 'Users', data: values }],
                // horizontal bars: categories go on the y axis; long labels are truncated.
                yaxis: { labels: { maxWidth: 140 } },
                xaxis: { categories: labels.map(clean), decimalsInFloat: 0 }
            }).render();

            horizontal('#affiliation-chart',
                @Json.Serialize(Model.Users.ByAffiliation.Select(x => x.Key)),
                @Json.Serialize(Model.Users.ByAffiliation.Select(x => x.Value)));

            horizontal('#country-chart',
                @Json.Serialize(Model.Users.ByCountry.Select(x => x.Key)),
                @Json.Serialize(Model.Users.ByCountry.Select(x => x.Value)));

            new ApexCharts(document.querySelector('#project-type-chart'), {
                chart: { type: 'donut', height: 260 },
                series: @Json.Serialize(new[] { Model.Projects.Public, Model.Projects.Private }),
                labels: ['Public', 'Private'],
                colors: ['#198754', '#6c757d'],
                legend: { position: 'bottom' }
            }).render();
        })();
    </script>
}
