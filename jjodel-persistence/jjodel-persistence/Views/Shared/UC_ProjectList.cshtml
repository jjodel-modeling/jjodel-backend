@model List<jjodel_persistence.Models.Entity.Project>
@{
    var timeZone = TimeZoneInfo.FindSystemTimeZoneById("Central Europe Standard Time");
}

<table id="project-list" class="table table-bordered table-hover" style="width:100%">
    <caption>All Projects</caption>
    <thead>
        <tr>
            <th data-priority="1">Name</th>
            <th>Description</th>
            <th data-priority="3">Type</th>
            <th>State</th>
            <th>Creation</th>
            <th data-priority="2">LastModified</th>
            <th data-priority="4">Author</th>
            <th>Number of Collaborator</th>
            <th class="all">Options</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>


                <td>@project.Name</td>
                <td>@project.Description</td>
                <td>@project.Type</td>
                @if(!string.IsNullOrEmpty(project.State)) {
                    <td> 
                        @project.State.Substring(0, 10)

                    </td>
                }
                else{
                    <td>-</td>
                }
                <td data-sort="@project.Creation.ToString("yyyy-MM-ddTHH:mm:ss")">@TimeZoneInfo.ConvertTimeFromUtc(project.Creation, timeZone).ToString("dd/MM/yyyy HH:mm")</td>
                <td data-sort="@project.LastModified.ToString("yyyy-MM-ddTHH:mm:ss")">@TimeZoneInfo.ConvertTimeFromUtc(project.LastModified, timeZone).ToString("dd/MM/yyyy HH:mm")</td>
                <td>@project.Author.UserName</td>
                <td>@project.Collaborators?.Count</td>



                <td>
                    <div class="d-grid gap-2 d-flex justify-content-center">
                        <button class="btn btn-primary editUserBtn" onclick="EditProject('@project.Id')" title="Edit Project">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-danger deleteUserBtn" onclick="DeleteProjectConfirm('@project.Id')" title="Delete Project">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Type</th>
            <th>State</th>
            <th>Creation</th>
            <th>LastModified</th>
            <th>AuthorId</th>
            <th>Number of Collaborator</th>
            <th>Options</th>

        </tr>
    </tfoot>
</table>

